{
  "name": "@supply-diets/backend-modules",
  "version": "1.0.0",
  "description": "Модульный backend API для Supply Diets и других проектов",
  "author": "Supply Diets Team",
  "license": "MIT",
  "keywords": [
    "backend",
    "fastify",
    "typescript",
    "api",
    "modules",
    "nutrition",
    "health"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --skipLibCheck",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "db:migrate": "tsx src/modules/database_module/migrate.ts",
    "db:seed": "tsx src/modules/database_module/seed.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^7.6.0",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^1.9.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "jsonwebtoken": "^9.0.2",
    "openai": "^5.12.0",
    "pg": "^8.11.3",
    "pino-pretty": "^10.2.3",
    "resend": "^2.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/node": "^20.8.10",
    "@types/pg": "^8.10.7",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.1.4",
    "typescript": "^5.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/backend-modules"
  },
  "bugs": {
    "url": "https://github.com/your-org/backend-modules/issues"
  },
  "homepage": "https://github.com/your-org/backend-modules#readme"
}

