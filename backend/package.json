{
  "name": "brix-nutrition-backend",
  "version": "1.0.0",
  "description": "Brix Nutritional App - Fastify Backend with ready modules",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:create": "node scripts/create-migration.js",
    "db:migrate:rollback": "node scripts/rollback.js",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "fastify",
    "typescript",
    "nutrition",
    "health",
    "api"
