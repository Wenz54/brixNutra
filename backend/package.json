  "author": "Brix Nutrition Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^7.6.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.0.0",
    "@supabase/supabase-js": "^2.75.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^5.23.2",
    "pg": "^8.11.3",
    "resend": "^2.0.0",
    "stripe": "^14.3.0",
    "twilio": "^4.19.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
